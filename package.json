{
  "name": "quick-command-deck",
  "displayName": "Quick Command Deck",
  "description": "把常用命令做成按钮，放在右侧辅助侧边栏（或左侧栏）；点击即直接执行真实命令，不依赖模拟按键。",
  "version": "0.2.0",
  "publisher": "YuHaoran251",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "commands",
    "sidebar",
    "auxiliary bar",
    "shortcuts",
    "productivity"
  ],
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/michalrees/quick-command-deck"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:quickCommandDeck.view",
    "onCommand:quickCommandDeck.open"
  ],
  "contributes": {
    "commands": [
      {
        "command": "quickCommandDeck.open",
        "title": "打开命令面板（侧边栏）",
        "category": "Quick Command Deck"
      },
      {
        "command": "quickCommandDeck.refresh",
        "title": "刷新命令可用性",
        "category": "Quick Command Deck",
        "icon": "$(refresh)"
      },
      {
        "command": "quickCommandDeck.setKeybindingsFile",
        "title": "选择快捷键文件（keybindings.json）",
        "category": "Quick Command Deck"
      },
      {
        "command": "quickCommandDeck.resetKeybindingsFile",
        "title": "恢复自动探测快捷键文件",
        "category": "Quick Command Deck"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "quickCommandDeck.refresh",
          "when": "view == quickCommandDeck.view",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "quickCommandDeck",
          "title": "Command Deck",
          "icon": "media/view-icon.svg"
        }
      ]
    },
    "views": {
      "quickCommandDeck": [
        {
          "id": "quickCommandDeck.view",
          "name": "快捷命令",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Quick Command Deck",
      "properties": {
        "quickCommandDeck.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 9,
          "maximum": 32,
          "description": "面板内文字字号（px）。"
        },
        "quickCommandDeck.showKeys": {
          "type": "boolean",
          "default": true,
          "description": "是否显示每条命令的默认键位。"
        },
        "quickCommandDeck.dense": {
          "type": "boolean",
          "default": false,
          "description": "紧凑模式：减小行距与内边距。"
        },
        "quickCommandDeck.includeExtensionCommands": {
          "type": "boolean",
          "default": true,
          "description": "是否把已安装扩展声明的键位也一起列进主列表（与内置清单自动去重）。关闭后只显示内置/自定义清单。"
        },
        "quickCommandDeck.keybindingsPath": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "手动指定要读取的 keybindings.json 绝对路径（留空 = 自动探测）。VS Code 没有 API 能读到当前生效的键位，本扩展只能直接读这个文件；自动探测在 portable / 远程 / 机器上放了多份 keybindings 变体时可能选错，可用命令「选择快捷键文件」或本项覆盖。支持 file:/// URI 与 ~ 前缀。"
        },
        "quickCommandDeck.commands": {
          "type": "array",
          "description": "要显示的命令列表。留空则使用内置的常用命令；数组顺序即显示顺序。",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "label",
              "command"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "按钮上显示的名称。"
              },
              "command": {
                "type": "string",
                "description": "要执行的 VS Code 命令 ID，例如 workbench.action.quickOpen。"
              },
              "keys": {
                "type": "string",
                "description": "默认键位，仅用于显示提示（例如 Ctrl+Shift+P）。"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "npm run compile && node tools/check-webview.js",
    "release": "pwsh -NoProfile -File tools/release.ps1",
    "release:dry": "pwsh -NoProfile -File tools/release.ps1 -DryRun",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  }
}
